<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:x="UnityEditor.UIElements" xmlns:xer="XericUI.ShaderBake.Editor">
    <!--
        Xeric UI Action Vessel — Bake Shader As Image 面板结构。
        这一份只管"有哪些块、块里有哪些控件、叫什么名字"，
        数值绑定与刷新逻辑全在 BakeShaderAsImageWindow.cs；样式见 BakeShaderWindow.uss。

        命名约定：
          sec-*    可折叠分组（head 是那个勾，body 是内容容器）
          src-/out-/surf-/cam-  分组内控件，前缀即所属分组
          props-rows  材质属性表的容器（行由 BakeShaderPropertyRow.uxml 模板克隆）
    -->

    <!-- 样式表由窗口代码加载（包在 Packages/ 还是 Assets/ 两条路径都要兼容），这里不重复引用 -->

    <ui:VisualElement name="bake-root" class="bake-root">

        <!-- ── 顶部工具栏：导出 / 渲染 / 预览缩放 / 重置 ── -->
        <x:Toolbar name="main-toolbar" class="main-toolbar">
            <x:ToolbarButton name="export-menu" text="导出 ▾" class="toolbar-emphasize" />
            <x:ToolbarButton name="render-now" text="重新渲染" />
            <x:ToolbarToggle name="auto-refresh" text="实时预览" />
            <x:ToolbarSpacer class="toolbar-gap" />
            <x:ToolbarButton name="zoom-out" text="-" class="tool-narrow" />
            <x:ToolbarButton name="zoom-fit" text="适应" />
            <x:ToolbarButton name="zoom-actual" text="1:1" />
            <x:ToolbarButton name="zoom-in" text="+" class="tool-narrow" />
            <x:ToolbarToggle name="show-checker" text="透明底" />
            <x:ToolbarSpacer class="toolbar-gap" />
            <x:ToolbarButton name="reset-settings" text="重置参数" />
        </x:Toolbar>

        <!-- ── 中部：左边浏览图，右边细节列表 ── -->
        <ui:VisualElement name="main-row" class="main-row">

            <ui:VisualElement name="preview-pane" class="preview-pane">
                <ui:ScrollView name="preview-viewport" class="preview-viewport" mode="Both">
                    <ui:VisualElement name="preview-stage" class="preview-stage">
                        <ui:VisualElement name="preview-frame" class="preview-frame">
                            <ui:Image name="preview-checker" class="preview-checker" />
                            <ui:Image name="preview-image" class="preview-image" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:ScrollView>
                <!-- 读数浮在预览区左下角：缩放比与像素尺寸是看图时才关心的东西，不该占一行 -->
                <ui:Label name="preview-readout" class="preview-readout" text="-" />
            </ui:VisualElement>

            <ui:VisualElement name="detail-split" class="detail-split" />

            <ui:ScrollView name="detail-pane" class="detail-pane" mode="Vertical">
                <ui:VisualElement name="detail-content" class="detail-content">

                    <!-- 输入源 -->
                    <ui:VisualElement name="sec-source" class="section">
                        <ui:Toggle name="sec-source-head" label="输入源" value="true" class="section-head" />
                        <ui:VisualElement name="sec-source-body" class="section-body">
                            <x:ObjectField name="src-shader" label="Shader" class="field-full" />
                            <x:ObjectField name="src-material" label="Material" class="field-full" />
                            <ui:Label name="src-note" class="field-note" text="未指定" />
                            <ui:VisualElement class="field-row">
                                <ui:Button name="src-apply" text="写回原材质" class="field-half" />
                                <ui:Button name="src-revert" text="丢弃改动" class="field-half" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 输出目标 -->
                    <ui:VisualElement name="sec-output" class="section">
                        <ui:Toggle name="sec-output-head" label="输出" value="true" class="section-head" />
                        <ui:VisualElement name="sec-output-body" class="section-body">
                            <ui:VisualElement class="field-row">
                                <xer:IntegerField name="out-width" label="宽" class="field-half" />
                                <xer:IntegerField name="out-height" label="高" class="field-half" />
                            </ui:VisualElement>
                            <ui:VisualElement class="field-row">
                                <xer:IntegerField name="out-depth" label="深度" class="field-half" />
                                <ui:DropdownField name="out-msaa" label="采样" class="field-half" />
                            </ui:VisualElement>
                            <xer:IntegerField name="out-pass" label="Pass 下标" class="field-full" />
                            <x:ColorField name="out-clear" label="背景色" class="field-full" />
                            <ui:Toggle name="out-hdr" label="HDR（浮点目标）" class="field-toggle" />
                            <ui:Toggle name="out-srgb" label="sRGB 存储" class="field-toggle" />
                            <ui:Toggle name="out-flip" label="上下翻转（读回方向不对时开）" class="field-toggle" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 面片 -->
                    <ui:VisualElement name="sec-surface" class="section">
                        <ui:Toggle name="sec-surface-head" label="面片" value="true" class="section-head" />
                        <ui:VisualElement name="sec-surface-body" class="section-body">
                            <xer:EnumField name="surf-kind" label="种类" class="field-full" />
                            <ui:VisualElement class="field-row">
                                <xer:FloatField name="surf-size-x" label="宽" class="field-half" />
                                <xer:FloatField name="surf-size-y" label="高" class="field-half" />
                            </ui:VisualElement>
                            <ui:VisualElement class="field-row">
                                <xer:IntegerField name="surf-seg-x" label="列" class="field-half" />
                                <xer:IntegerField name="surf-seg-y" label="行" class="field-half" />
                            </ui:VisualElement>
                            <ui:Label class="field-note" text="UV" />
                            <ui:VisualElement class="field-row">
                                <xer:FloatField name="surf-uv-off-x" label="偏移X" class="field-half" />
                                <xer:FloatField name="surf-uv-off-y" label="偏移Y" class="field-half" />
                            </ui:VisualElement>
                            <ui:VisualElement class="field-row">
                                <xer:FloatField name="surf-uv-tile-x" label="重复X" class="field-half" />
                                <xer:FloatField name="surf-uv-tile-y" label="重复Y" class="field-half" />
                            </ui:VisualElement>
                            <ui:Label class="field-note" text="面片变换" />
                            <ui:VisualElement class="field-row">
                                <xer:FloatField name="surf-pos-x" label="X" class="field-third" />
                                <xer:FloatField name="surf-pos-y" label="Y" class="field-third" />
                                <xer:FloatField name="surf-pos-z" label="Z" class="field-third" />
                            </ui:VisualElement>
                            <ui:VisualElement class="field-row">
                                <xer:FloatField name="surf-rot-x" label="X" class="field-third" />
                                <xer:FloatField name="surf-rot-y" label="Y" class="field-third" />
                                <xer:FloatField name="surf-rot-z" label="Z" class="field-third" />
                            </ui:VisualElement>
                            <ui:VisualElement class="field-row">
                                <xer:FloatField name="surf-scale-x" label="X" class="field-third" />
                                <xer:FloatField name="surf-scale-y" label="Y" class="field-third" />
                                <xer:FloatField name="surf-scale-z" label="Z" class="field-third" />
                            </ui:VisualElement>
                            <ui:Label class="field-note" text="外部网格" />
                            <x:ObjectField name="surf-mesh" label="网格" class="field-full" />
                            <xer:IntegerField name="surf-submesh" label="SubMesh" class="field-full" />
                            <ui:Toggle name="surf-normalize" label="缩放到面片尺寸" class="field-toggle" />
                            <ui:Toggle name="surf-uv-st" label="UV 再写进 _MainTex_ST" class="field-toggle" />
                            <ui:VisualElement class="field-row">
                                <ui:Button name="surf-reset" text="面片归位" class="field-half" />
                                <ui:Button name="surf-pick-scene" text="取选中物体" class="field-half" />
                            </ui:VisualElement>
                            <ui:Button name="surf-import-model" text="导入模型文件…" class="field-full" />
                            <ui:VisualElement class="field-row">
                                <ui:Button name="surf-rot-90" text="绕Z转90" class="field-third" />
                                <ui:Button name="surf-flip-u" text="U镜像" class="field-third" />
                                <ui:Button name="surf-flip-v" text="V镜像" class="field-third" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 离屏相机 -->
                    <ui:VisualElement name="sec-camera" class="section">
                        <ui:Toggle name="sec-camera-head" label="相机" value="true" class="section-head" />
                        <ui:VisualElement name="sec-camera-body" class="section-body">
                            <ui:Toggle name="cam-ortho" label="正交" class="field-toggle" />
                            <xer:FloatField name="cam-ortho-size" label="正交半高" class="field-full" />
                            <xer:FloatField name="cam-fov" label="视野角" class="field-full" />
                            <ui:VisualElement class="field-row">
                                <xer:FloatField name="cam-near" label="近" class="field-half" />
                                <xer:FloatField name="cam-far" label="远" class="field-half" />
                            </ui:VisualElement>
                            <ui:Label class="field-note" text="位置" />
                            <ui:VisualElement class="field-row">
                                <xer:FloatField name="cam-pos-x" label="X" class="field-third" />
                                <xer:FloatField name="cam-pos-y" label="Y" class="field-third" />
                                <xer:FloatField name="cam-pos-z" label="Z" class="field-third" />
                            </ui:VisualElement>
                            <ui:Label class="field-note" text="旋转（欧拉角）" />
                            <ui:VisualElement class="field-row">
                                <xer:FloatField name="cam-rot-x" label="X" class="field-third" />
                                <xer:FloatField name="cam-rot-y" label="Y" class="field-third" />
                                <xer:FloatField name="cam-rot-z" label="Z" class="field-third" />
                            </ui:VisualElement>
                            <ui:Button name="cam-fit" text="框住面片" class="field-full" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 材质属性表：行来自 BakeShaderPropertyRow.uxml -->
                    <ui:VisualElement name="sec-props" class="section">
                        <ui:Toggle name="sec-props-head" label="材质属性" value="true" class="section-head" />
                        <ui:VisualElement name="sec-props-body" class="section-body">
                            <ui:VisualElement name="props-rows" class="props-rows" />
                            <ui:Label name="props-note" class="field-note" text="未指定 shader" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>

        <!-- ── 底部状态栏 ── -->
        <x:Toolbar name="status-bar" class="status-bar">
            <ui:Label name="status-message" class="status-message" text="未渲染" />
            <x:ToolbarSpacer class="toolbar-gap" />
            <ui:Label name="status-source" class="status-readout" text="-" />
            <ui:Label name="status-size" class="status-readout" text="-" />
            <ui:Label name="status-time" class="status-readout" text="-" />
        </x:Toolbar>
    </ui:VisualElement>
</ui:UXML>
